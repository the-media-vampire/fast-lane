# Copy to .env.local and fill in your own keys. .env.local is git-ignored; never commit keys.
# Keep comments on their own lines (text after a value is read as part of the value).

# Astra (the agent) and all planning, concept and review calls.
ANTHROPIC_API_KEY=

# Media generation, read by lib/adapters/media.ts once you implement it (see the README,
# "Connecting generation"). These are the providers the prototype used.
# Kie: pictures (GPT Image 2, fallback Seedream), video (Seedance 2.5), music (Suno)
KIE_API_KEY=
# ElevenLabs: voice lines with word timings
ELEVENLABS_API_KEY=
# Vercel Blob: public URLs for reference images and frames handed to providers
BLOB_READ_WRITE_TOKEN=

# Optional
# Spending off: no model call or purchase can happen
FASTLANE_LIVE=off
# 480p (default), 720p or 1080p
# FASTLANE_VIDEO_RESOLUTION=480p
# Start the server without the background worker
FASTLANE_WORKER=off
# Where the database and media live (default ./data)
# FASTLANE_DATA_DIR=./data
# FFMPEG_BIN=/opt/homebrew/bin/ffmpeg
# FFPROBE_BIN=/opt/homebrew/bin/ffprobe
